# =============================================================
# Regalo Secreto — variables de entorno
# Copia este archivo a  .env  y completa tus valores.
# NUNCA subas el archivo .env a git (ya está en .gitignore).
# =============================================================

# --- Supabase (Panel → Project Settings → API) ---
# Project URL
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# anon public key (segura para el navegador)
VITE_SUPABASE_ANON_KEY=PEGA_AQUÍ_TU_LLAVE_ANON

# --- Web Push (VAPID) ---
# Genera las llaves con:  npx web-push generate-vapid-keys
# La PRIVADA NO va aquí: se guarda como secreto de la Edge Function "notificar".
VITE_VAPID_PUBLIC_KEY=PEGA_AQUÍ_TU_LLAVE_PÚBLICA_VAPID

# --- Opcional: despliegue ---
# Vercel lee estas automáticamente si las agregas en el panel de Vercel
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_VAPID_PUBLIC_KEY=
